{
  "name": "cfdi4-api",
  "version": "1.0.0",
  "description": "Transforms structured JSON payloads into valid SAT-compliant CFDI 4.0 XML — supports Ingreso, Egreso and Pago document types.",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev:bot": "ts-node-dev --respawn src/bot-server.ts",
    "start:bot": "node dist/bot-server.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}